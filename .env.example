<![CDATA[# ============================================================================
# Environment Configuration — licence-docker v3.2
# ============================================================================
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
# ============================================================================

# --- License Paths ----------------------------------------------------------
LICENSE_DIR=./License
LICENSE_FILE=license.key
PUBLIC_KEY_FILE=./keys/public_key.pem

# --- NTP / Time Enforcement -------------------------------------------------
NTP_SERVER=pool.ntp.org
NTP_STRICT=true

# --- Hardware ID ------------------------------------------------------------
# Set to "true" ONLY during development to bypass HWID verification
SKIP_HWID_CHECK=false

# --- VM / Container Detection -----------------------------------------------
# Set to "true" in production to block VM/hypervisor environments
BLOCK_VM=false

# --- Cache ------------------------------------------------------------------
CACHE_TTL=3600

# --- Phone Home (Required for Docker deployments in v3.2) -------------------
# PHONE_HOME_URL=https://your-server.com/api/license/beacon

# --- Kubernetes Only --------------------------------------------------------
# LICENSE_HWID=         # Explicit HWID (K8s node name)
# LICENSE_HWID_SIG=     # RSA signature of LICENSE_HWID (vendor-signed)
]]>
